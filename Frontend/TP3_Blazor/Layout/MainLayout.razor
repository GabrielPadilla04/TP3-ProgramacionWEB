@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider /> <!-- ¡ESTE ES EL QUE FALTABA Y HACE QUE SE DESPLIEGUEN LOS MENÚS! -->
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <!-- El botón del menú solo se renderiza si el usuario está logueado -->
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@DrawerToggle" />
            </Authorized>
        </AuthorizeView>

        <MudText Typo="Typo.h6" Class="ml-3">Sistema POS</MudText>
        <MudSpacer />
        <MudLink Href="https://learn.microsoft.com/aspnet/core/" Target="_blank" Color="Color.Inherit">About</MudLink>
    </MudAppBar>

    <!-- El panel lateral completo solo se renderiza si el usuario está logueado -->
    <AuthorizeView>
        <Authorized>
            <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always">
                <NavMenu />
            </MudDrawer>
        </Authorized>
    </AuthorizeView>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4 pb-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}