@page "/ingreso-mercaderia"
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Ingreso de Mercadería - Administración</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudGrid>
        <!-- SECCIÓN IZQUIERDA: Formulario de Carga y Creación -->
        <MudItem xs="12" md="6">
            <MudCard Elevation="3" Class="mb-4">
                <MudCardContent>
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                        <MudText Typo="Typo.h5">Registrar Entrada de Mercadería</MudText>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ToggleModoNuevoProducto">
                            @(mostrarFormNuevoProducto ? "← Volver a Selección" : "+ Crear Producto Nuevo")
                        </MudButton>
                    </MudStack>

                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="() => mensajeError = string.Empty" Class="mb-3">
                            @mensajeError
                        </MudAlert>
                    }

                    @if (!string.IsNullOrEmpty(mensajeExito))
                    {
                        <MudAlert Severity="Severity.Success" ShowCloseIcon="true" CloseIconClicked="() => mensajeExito = string.Empty" Class="mb-3">
                            @mensajeExito
                        </MudAlert>
                    }

                    <MudTextField @bind-Value="proveedor" Label="Proveedor" Placeholder="Ej: Distribuidora Mayorista S.A." Variant="Variant.Outlined" Class="mb-3" />

                    <MudDivider Class="my-4" />

                    @if (!mostrarFormNuevoProducto)
                    {
                        <!-- MODO SELECCIÓN CON AUTOCOMPLETADO -->
                        <MudText Typo="Typo.h6" Class="mb-3">Agregar Producto al Ingreso</MudText>

                        <MudAutocomplete T="ProductoModel" 
                                         Label="Buscar Producto (Nombre o Código)" 
                                         SearchFunc="BuscarProductosEnApi" 
                                         ToStringFunc="@(p => p == null ? null : $"{p.Nombre} (Stock: {p.StockActual} | Venta: ${p.PrecioVenta})")"
                                         ValueChanged="OnProductoSeleccionado" 
                                         Variant="Variant.Outlined" 
                                         Class="mb-3"
                                         Placeholder="Escribe para buscar..."
                                         ResetValueOnEmptyText="true" 
                                         CoerceText="true" 
                                         CoerceValue="false" />

                        <MudNumericField @bind-Value="cantidad" Label="Cantidad a ingresar" Min="1" Variant="Variant.Outlined" Class="mb-3" />

                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="costoUnitario" Label="Costo Unitario ($)" Min="0" Step="0.01M" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="nuevoPrecioVentaItem" Label="Nuevo Precio Venta ($)" Min="0" Step="0.01M" Variant="Variant.Outlined" />
                            </MudItem>
                        </MudGrid>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4" OnClick="AgregarItemAlDetalle">
                            Agregar al Listado de Ingreso
                        </MudButton>
                    }
                    else
                    {
                        <!-- MODO CREAR PRODUCTO NUEVO AL VUELO -->
                        <MudPaper Class="pa-4" Elevation="0" Outlined="true" Style="background-color: var(--mud-palette-background-grey);">
                            <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-3">Nuevo Producto en el Catálogo</MudText>

                            <MudTextField @bind-Value="nuevoCodigoBarras" Label="Código de Barras" Placeholder="Ej: 779..." Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                            
                            <MudTextField @bind-Value="nuevoNombre" Label="Nombre del Producto" Placeholder="Ej: Gaseosa Lima 2L" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />

                            <MudGrid>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField @bind-Value="nuevoPrecioCosto" Label="Precio de Costo ($)" Step="0.01M" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField @bind-Value="nuevoPrecioVenta" Label="Precio de Venta ($)" Step="0.01M" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                            </MudGrid>

                            <MudNumericField @bind-Value="nuevoStockMinimo" Label="Stock Mínimo" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2 mb-3" />

                            <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Size="Size.Small" OnClick="CrearYSeleccionarNuevoProducto">
                                Guardar y Agregar al Ingreso
                            </MudButton>
                        </MudPaper>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- SECCIÓN DERECHA: Resumen de la Entrada -->
        <MudItem xs="12" md="6">
            <MudCard Elevation="3">
                <MudCardContent>
                    <MudText Typo="Typo.h5" Class="mb-4">Detalle de la Operación</MudText>

                    @if (!detalles.Any())
                    {
                        <MudText Color="Color.Default">No hay productos agregados en este ingreso.</MudText>
                    }
                    else
                    {
                        <MudList T="EntradaDetalleDto" Class="mb-3">
                            @foreach (var item in detalles)
                            {
                                var prod = productosCache.FirstOrDefault(p => p.Id == item.ProductoId);
                                <MudListItem T="EntradaDetalleDto">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.subtitle1"><strong>@(prod?.Nombre ?? "Producto Desconocido")</strong></MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Default">
                                                Cant: @item.Cantidad | Costo: $@item.CostoUnitario | Nuevo Venta: $@item.NuevoPrecioVenta
                                            </MudText>
                                        </MudStack>
                                        <MudStack Row="true" AlignItems="AlignItems.Center">
                                            <MudText Typo="Typo.subtitle1"><strong>$@(item.Cantidad * item.CostoUnitario)</strong></MudText>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => detalles.Remove(item)" />
                                        </MudStack>
                                    </MudStack>
                                </MudListItem>
                                <MudDivider />
                            }
                        </MudList>

                        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-4 mt-2">
                            <MudText Typo="Typo.h6"><strong>Total Inversión:</strong></MudText>
                            <MudText Typo="Typo.h6"><strong>$@detalles.Sum(i => i.Cantidad * i.CostoUnitario)</strong></MudText>
                        </MudStack>

                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" OnClick="RegistrarEntradaMercaderia">
                            Confirmar Ingreso de Stock
                        </MudButton>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    // Caché ligero: ya no guardamos los 10,000 productos, solo los que buscamos y seleccionamos
    private List<ProductoModel> productosCache = new(); 
    
    private string proveedor = string.Empty;
    private int selectedProductoId;
    private int cantidad = 1;
    private decimal costoUnitario = 0;
    private decimal nuevoPrecioVentaItem = 0;

    private bool mostrarFormNuevoProducto = false;
    private string nuevoCodigoBarras = string.Empty;
    private string nuevoNombre = string.Empty;
    private decimal nuevoPrecioCosto = 0;
    private decimal nuevoPrecioVenta = 0;
    private int nuevoStockMinimo = 5;

    private List<EntradaDetalleDto> detalles = new();

    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;

    // Método que MudAutocomplete llama automáticamente al escribir
    private async Task<IEnumerable<ProductoModel>> BuscarProductosEnApi(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return new List<ProductoModel>();

        try
        {
            var response = await Http.GetFromJsonAsync<List<ProductoModel>>($"api/Productos/buscar?filtro={Uri.EscapeDataString(value)}", token);
            return response ?? new List<ProductoModel>();
        }
        catch
        {
            return new List<ProductoModel>();
        }
    }

    // Método adaptado para recibir el objeto producto completo desde MudAutocomplete
    private void OnProductoSeleccionado(ProductoModel? prod)
    {
        if (prod != null)
        {
            selectedProductoId = prod.Id;
            costoUnitario = prod.PrecioCosto;
            nuevoPrecioVentaItem = prod.PrecioVenta;

            if (!productosCache.Any(p => p.Id == prod.Id))
            {
                productosCache.Add(prod);
            }
        }
        else
        {
            selectedProductoId = 0;
        }
    }

    private void ToggleModoNuevoProducto()
    {
        mostrarFormNuevoProducto = !mostrarFormNuevoProducto;
        mensajeError = string.Empty;
        mensajeExito = string.Empty;
    }

    private async Task CrearYSeleccionarNuevoProducto()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        if (string.IsNullOrWhiteSpace(nuevoNombre) || string.IsNullOrWhiteSpace(nuevoCodigoBarras))
        {
            mensajeError = "El nombre y el código de barras son obligatorios para el nuevo producto.";
            return;
        }

        try
        {
            var nuevoProdDto = new
            {
                CodigoBarras = nuevoCodigoBarras,
                Nombre = nuevoNombre,
                PrecioCosto = nuevoPrecioCosto,
                PrecioVenta = nuevoPrecioVenta,
                StockActual = 0,
                StockMinimo = nuevoStockMinimo
            };

            var response = await Http.PostAsJsonAsync("api/Productos", nuevoProdDto);
            if (response.IsSuccessStatusCode)
            {
                var productoCreado = await response.Content.ReadFromJsonAsync<ProductoModel>();

                if (productoCreado != null)
                {
                    selectedProductoId = productoCreado.Id;
                    costoUnitario = nuevoPrecioCosto;
                    nuevoPrecioVentaItem = nuevoPrecioVenta;
                    
                    productosCache.Add(productoCreado);
                }

                mostrarFormNuevoProducto = false;
                nuevoCodigoBarras = string.Empty;
                nuevoNombre = string.Empty;
                nuevoPrecioCosto = 0;
                nuevoPrecioVenta = 0;

                mensajeExito = "¡Producto creado con éxito! Ya puedes asignarle cantidad y agregarlo.";
            }
            else
            {
                mensajeError = "No se pudo registrar el nuevo producto en la API.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al crear producto: {ex.Message}";
        }
    }

    private void AgregarItemAlDetalle()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        if (selectedProductoId == 0)
        {
            mensajeError = "Debes seleccionar un producto válido.";
            return;
        }

        if (cantidad <= 0)
        {
            mensajeError = "La cantidad a ingresar debe ser mayor a 0.";
            return;
        }

        if (costoUnitario < 0 || nuevoPrecioVentaItem < 0)
        {
            mensajeError = "Los costos y precios no pueden ser negativos.";
            return;
        }

        var existente = detalles.FirstOrDefault(d => d.ProductoId == selectedProductoId);
        if (existente != null)
        {
            existente.Cantidad += cantidad;
            existente.CostoUnitario = costoUnitario;
            existente.NuevoPrecioVenta = nuevoPrecioVentaItem;
        }
        else
        {
            detalles.Add(new EntradaDetalleDto
            {
                ProductoId = selectedProductoId,
                Cantidad = cantidad,
                CostoUnitario = costoUnitario,
                NuevoPrecioVenta = nuevoPrecioVentaItem
            });
        }

        selectedProductoId = 0;
        cantidad = 1;
        costoUnitario = 0;
        nuevoPrecioVentaItem = 0;
    }

    private async Task RegistrarEntradaMercaderia()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        if (string.IsNullOrWhiteSpace(proveedor))
        {
            mensajeError = "El campo 'Proveedor' es obligatorio.";
            return;
        }

        if (!detalles.Any())
        {
            mensajeError = "El listado de entrada está vacío.";
            return;
        }

        try
        {
            var dto = new
            {
                Proveedor = proveedor,
                Detalles = detalles
            };

            var response = await Http.PostAsJsonAsync("api/EntradasMercaderia", dto);

            if (response.IsSuccessStatusCode)
            {
                mensajeExito = "¡Entrada de mercadería registrada y stock actualizado correctamente!";
                proveedor = string.Empty;
                detalles.Clear();
            }
            else
            {
                mensajeError = "Ocurrió un error al registrar la entrada en la API.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error de conexión con la API: {ex.Message}";
        }
    }

    public class ProductoModel
    {
        public int Id { get; set; }
        public string CodigoBarras { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
        public decimal PrecioCosto { get; set; }
        public decimal PrecioVenta { get; set; }
        public int StockActual { get; set; }
    }

    public class EntradaDetalleDto
    {
        public int ProductoId { get; set; }
        public int Cantidad { get; set; }
        public decimal CostoUnitario { get; set; }
        public decimal NuevoPrecioVenta { get; set; }
    }
}