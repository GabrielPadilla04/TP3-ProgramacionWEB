@page "/ingreso-mercaderia"
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Ingreso de Mercadería - Administración</PageTitle>

<div class="container-fluid mt-4">
    <div class="row">
        <!-- SECCIÓN IZQUIERDA: Formulario de Carga y Creación -->
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="card-title m-0">Registrar Entrada de Mercadería</h3>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleModoNuevoProducto">
                            @(mostrarFormNuevoProducto ? "← Volver a Selección" : "+ Crear Producto Nuevo")
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @mensajeError
                            <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(mensajeExito))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @mensajeExito
                            <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Proveedor:</label>
                        <input type="text" class="form-control" @bind="proveedor" placeholder="Ej: Distribuidora Mayorista S.A." />
                    </div>

                    <hr />

                    @if (!mostrarFormNuevoProducto)
                    {
                        <!-- MODO SELECCIÓN DE PRODUCTO EXISTENTE -->
                        <h5 class="mb-3">Agregar Producto al Ingreso</h5>

                        <div class="mb-3">
                            <label class="form-label">Seleccionar Producto:</label>
                            <select class="form-select" @onchange="OnProductoSeleccionado">
                                <option value="0">-- Seleccione un producto --</option>
                                @if (productos != null)
                                {
                                    @foreach (var p in productos)
                                    {
                                        <option value="@p.Id" selected="@(p.Id == selectedProductoId)">
                                            @p.Nombre (Stock: @p.StockActual | Venta: $@p.PrecioVenta)
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Cantidad a ingresar:</label>
                            <input type="number" class="form-control" @bind="cantidad" min="1" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Costo Unitario ($):</label>
                                <input type="number" step="0.01" class="form-control" @bind="costoUnitario" min="0" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nuevo Precio Venta ($):</label>
                                <input type="number" step="0.01" class="form-control" @bind="nuevoPrecioVentaItem" min="0" />
                            </div>
                        </div>

                        <button class="btn btn-primary w-100" @onclick="AgregarItemAlDetalle">
                            Agregar al Listado de Ingreso
                        </button>
                    }
                    else
                    {
                        <!-- MODO CREAR PRODUCTO NUEVO AL VUELO -->
                        <div class="p-3 border rounded bg-light mb-3">
                            <h5 class="text-primary mb-3">Nuevo Producto en el Catálogo</h5>

                            <div class="mb-2">
                                <label class="form-label small">Código de Barras:</label>
                                <input type="text" class="form-control form-control-sm" @bind="nuevoCodigoBarras" placeholder="Ej: 779..." />
                            </div>

                            <div class="mb-2">
                                <label class="form-label small">Nombre del Producto:</label>
                                <input type="text" class="form-control form-control-sm" @bind="nuevoNombre" placeholder="Ej: Gaseosa Lima 2L" />
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label class="form-label small">Precio de Costo ($):</label>
                                    <input type="number" step="0.01" class="form-control form-control-sm" @bind="nuevoPrecioCosto" />
                                </div>
                                <div class="col-md-6 mb-2">
                                    <label class="form-label small">Precio de Venta ($):</label>
                                    <input type="number" step="0.01" class="form-control form-control-sm" @bind="nuevoPrecioVenta" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small">Stock Mínimo:</label>
                                <input type="number" class="form-control form-control-sm" @bind="nuevoStockMinimo" />
                            </div>

                            <button class="btn btn-success btn-sm w-100" @onclick="CrearYSeleccionarNuevoProducto">
                                Guardar y Agregar al Ingreso
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- SECCIÓN DERECHA: Resumen de la Entrada -->
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title mb-3">Detalle de la Operación</h4>

                    @if (!detalles.Any())
                    {
                        <p class="text-muted">No hay productos agregados en este ingreso.</p>
                    }
                    else
                    {
                        <ul class="list-group mb-3">
                            @foreach (var item in detalles)
                            {
                                var prod = productos?.FirstOrDefault(p => p.Id == item.ProductoId);
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="my-0">@(prod?.Nombre ?? "Producto")</h6>
                                        <small class="text-muted">Cant: @item.Cantidad | Costo: $@item.CostoUnitario | Nuevo Venta: $@item.NuevoPrecioVenta</small>
                                    </div>
                                    <span class="text-muted">$@(item.Cantidad * item.CostoUnitario)</span>
                                    <button class="btn btn-sm btn-danger ms-2" @onclick="() => detalles.Remove(item)">X</button>
                                </li>
                            }
                        </ul>

                        <div class="d-flex justify-content-between mb-3">
                            <strong>Total Inversión:</strong>
                            <strong>$@detalles.Sum(i => i.Cantidad * i.CostoUnitario)</strong>
                        </div>

                        <button class="btn btn-success w-100" @onclick="RegistrarEntradaMercaderia">
                            Confirmar Ingreso de Stock
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ProductoModel>? productos;
    private string proveedor = string.Empty;
    private int selectedProductoId;
    private int cantidad = 1;
    private decimal costoUnitario = 0;
    private decimal nuevoPrecioVentaItem = 0;

    private bool mostrarFormNuevoProducto = false;
    private string nuevoCodigoBarras = string.Empty;
    private string nuevoNombre = string.Empty;
    private decimal nuevoPrecioCosto = 0;
    private decimal nuevoPrecioVenta = 0;
    private int nuevoStockMinimo = 5;

    private List<EntradaDetalleDto> detalles = new();

    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
    }

    private async Task CargarProductos()
    {
        try
        {
            productos = await Http.GetFromJsonAsync<List<ProductoModel>>("api/Productos");
        }
        catch
        {
            mensajeError = "No se pudieron cargar los productos desde la API.";
        }
    }

    private void OnProductoSeleccionado(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            selectedProductoId = id;
            var prod = productos?.FirstOrDefault(p => p.Id == id);
            if (prod != null)
            {
                costoUnitario = prod.PrecioCosto;
                nuevoPrecioVentaItem = prod.PrecioVenta;
            }
        }
    }

    private void ToggleModoNuevoProducto()
    {
        mostrarFormNuevoProducto = !mostrarFormNuevoProducto;
        mensajeError = string.Empty;
        mensajeExito = string.Empty;
    }

    private async Task CrearYSeleccionarNuevoProducto()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        if (string.IsNullOrWhiteSpace(nuevoNombre) || string.IsNullOrWhiteSpace(nuevoCodigoBarras))
        {
            mensajeError = "El nombre y el código de barras son obligatorios para el nuevo producto.";
            return;
        }

        try
        {
            var nuevoProdDto = new
            {
                CodigoBarras = nuevoCodigoBarras,
                Nombre = nuevoNombre,
                PrecioCosto = nuevoPrecioCosto,
                PrecioVenta = nuevoPrecioVenta,
                StockActual = 0,
                StockMinimo = nuevoStockMinimo
            };

            var response = await Http.PostAsJsonAsync("api/Productos", nuevoProdDto);
            if (response.IsSuccessStatusCode)
            {
                var productoCreado = await response.Content.ReadFromJsonAsync<ProductoModel>();
                await CargarProductos();

                if (productoCreado != null)
                {
                    selectedProductoId = productoCreado.Id;
                    costoUnitario = nuevoPrecioCosto;
                    nuevoPrecioVentaItem = nuevoPrecioVenta;
                }

                mostrarFormNuevoProducto = false;
                nuevoCodigoBarras = string.Empty;
                nuevoNombre = string.Empty;
                nuevoPrecioCosto = 0;
                nuevoPrecioVenta = 0;

                mensajeExito = "¡Producto creado con éxito! Ya puedes asignarle cantidad y agregarlo.";
            }
            else
            {
                mensajeError = "No se pudo registrar el nuevo producto en la API.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al crear producto: {ex.Message}";
        }
    }

    private void AgregarItemAlDetalle()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        if (selectedProductoId == 0)
        {
            mensajeError = "Debes seleccionar un producto válido.";
            return;
        }

        if (cantidad <= 0)
        {
            mensajeError = "La cantidad a ingresar debe ser mayor a 0.";
            return;
        }

        if (costoUnitario < 0 || nuevoPrecioVentaItem < 0)
        {
            mensajeError = "Los costos y precios no pueden ser negativos.";
            return;
        }

        var existente = detalles.FirstOrDefault(d => d.ProductoId == selectedProductoId);
        if (existente != null)
        {
            existente.Cantidad += cantidad;
            existente.CostoUnitario = costoUnitario;
            existente.NuevoPrecioVenta = nuevoPrecioVentaItem;
        }
        else
        {
            detalles.Add(new EntradaDetalleDto
            {
                ProductoId = selectedProductoId,
                Cantidad = cantidad,
                CostoUnitario = costoUnitario,
                NuevoPrecioVenta = nuevoPrecioVentaItem
            });
        }

        selectedProductoId = 0;
        cantidad = 1;
        costoUnitario = 0;
        nuevoPrecioVentaItem = 0;
    }

    private async Task RegistrarEntradaMercaderia()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        if (string.IsNullOrWhiteSpace(proveedor))
        {
            mensajeError = "El campo 'Proveedor' es obligatorio.";
            return;
        }

        if (!detalles.Any())
        {
            mensajeError = "El listado de entrada está vacío.";
            return;
        }

        try
        {
            var dto = new
            {
                Proveedor = proveedor,
                Detalles = detalles
            };

            var response = await Http.PostAsJsonAsync("api/EntradasMercaderia", dto);

            if (response.IsSuccessStatusCode)
            {
                mensajeExito = "¡Entrada de mercadería registrada y stock actualizado correctamente!";
                proveedor = string.Empty;
                detalles.Clear();
                await CargarProductos();
            }
            else
            {
                mensajeError = "Ocurrió un error al registrar la entrada en la API.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error de conexión con la API: {ex.Message}";
        }
    }

    public class ProductoModel
    {
        public int Id { get; set; }
        public string CodigoBarras { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
        public decimal PrecioCosto { get; set; }
        public decimal PrecioVenta { get; set; }
        public int StockActual { get; set; }
    }

    public class EntradaDetalleDto
    {
        public int ProductoId { get; set; }
        public int Cantidad { get; set; }
        public decimal CostoUnitario { get; set; }
        public decimal NuevoPrecioVenta { get; set; }
    }
}