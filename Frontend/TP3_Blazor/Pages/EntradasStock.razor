@page "/entradas-stock"
@attribute [Authorize(Roles = "Admin")] // Protegido para que solo el Admin pueda ingresar mercadería
@inject HttpClient Http

<PageTitle>Ingreso de Mercadería</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudCard Elevation="4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Color="Color.Primary">Registrar Entrada de Mercadería</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @if (!string.IsNullOrEmpty(mensajeExito))
            {
                <MudAlert Severity="Severity.Success" ShowCloseIcon="true" CloseIconClicked="() => mensajeExito = string.Empty" Class="mb-4">
                    @mensajeExito
                </MudAlert>
            }

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="() => mensajeError = string.Empty" Class="mb-4">
                    @mensajeError
                </MudAlert>
            }

            <MudSelect T="int" @bind-Value="entradaModel.ProductoId" Label="Seleccionar Producto" Variant="Variant.Outlined" Class="mb-4" AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem Value="0">-- Seleccione un producto --</MudSelectItem>
                @if (products != null)
                {
                    @foreach (var p in products)
                    {
                        <MudSelectItem Value="@p.Id">@p.Name (Stock actual: @p.Stock)</MudSelectItem>
                    }
                }
            </MudSelect>

            <MudNumericField @bind-Value="entradaModel.Cantidad" Label="Cantidad a Ingresar" Variant="Variant.Outlined" Min="1" Class="mb-4" />

            <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Size="Size.Large" OnClick="RegistrarEntrada">
                Guardar Entrada
            </MudButton>
        </MudCardContent>
    </MudCard>
</MudContainer>



@code {
    private EntradaStockModel entradaModel = new();
    private List<ProductModel>? products;
    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            products = await Http.GetFromJsonAsync<List<ProductModel>>("api/Products");
        }
        catch (Exception)
        {
            mensajeError = "No se pudo cargar el listado de productos.";
        }
    }

    private async Task RegistrarEntrada()
    {
        mensajeExito = string.Empty;
        mensajeError = string.Empty;

        if (entradaModel.ProductoId == 0 || entradaModel.Cantidad <= 0)
        {
            mensajeError = "Por favor, seleccione un producto válido y una cantidad mayor a cero.";
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/EntradasStock", entradaModel);

            if (response.IsSuccessStatusCode)
            {
                mensajeExito = "¡Entrada de mercadería registrada correctamente y stock actualizado!";
                entradaModel = new(); // Limpiar formulario

                // Recargar productos para refrescar el stock visualizado
                products = await Http.GetFromJsonAsync<List<ProductModel>>("api/Products");
            }
            else
            {
                mensajeError = "Error al registrar la entrada en el servidor.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error de conexión: {ex.Message}";
        }
    }

    public class EntradaStockModel
    {
        public int ProductoId { get; set; }
        public int Cantidad { get; set; }
    }

    public class ProductModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public int Stock { get; set; }
    }
}