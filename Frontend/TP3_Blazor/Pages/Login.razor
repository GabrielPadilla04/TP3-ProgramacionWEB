@page "/login"
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Iniciar Sesión - POS</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-12">
    <MudCard Elevation="4" Class="pa-4">
        <MudCardContent>
            <MudStack AlignItems="AlignItems.Center" Class="mb-6">
                <MudIcon Icon="@Icons.Material.Filled.PointOfSale" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h4" Color="Color.Primary">Iniciar Sesión</MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Default">Punto de Venta</MudText>
            </MudStack>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="() => errorMessage = string.Empty" Class="mb-4">
                    @errorMessage
                </MudAlert>
            }

            <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="loginModel.Email"
                              For="@(() => loginModel.Email)"
                              Label="Correo Electrónico"
                              Placeholder="correo@ejemplo.com"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              Class="mb-4" />

                <MudTextField @bind-Value="loginModel.Password"
                              For="@(() => loginModel.Password)"
                              Label="Contraseña"
                              Placeholder="••••••••"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Class="mb-6" />

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           FullWidth="true">
                    Ingresar
                </MudButton>
            </EditForm>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private LoginModel loginModel = new();
    private string errorMessage = string.Empty;

    private async Task HandleLogin()
    {
        errorMessage = string.Empty;
        var success = await AuthService.Login(loginModel);

        if (success)
        {
            // Redirigimos al punto de venta o panel principal tras un login exitoso
            NavigationManager.NavigateTo("/pos");
        }
        else
        {
            errorMessage = "Credenciales inválidas. Por favor, verificá tus datos.";
        }
    }
}