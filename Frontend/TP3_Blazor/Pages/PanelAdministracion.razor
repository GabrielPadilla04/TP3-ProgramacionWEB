@page "/admin/administracion"
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Panel de Administración</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudCard Elevation="3">
        <MudCardContent>
            <MudText Typo="Typo.h5" Class="mb-3">Panel de Administración General</MudText>

            <MudText Typo="Typo.body1" Color="Color.Default" Class="mb-4">
                Centro de control exclusivo para administradores. Desde aquí podés auditar la información global del sistema y descargar el informe consolidado exigido por la cátedra.
            </MudText>

            <MudDivider Class="mb-4" />

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="() => mensajeError = string.Empty" Class="mb-4">
                    @mensajeError
                </MudAlert>
            }

            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                           OnClick="DescargarPdfGeneral">
                    Descargar Reporte General Consolidado (PDF)
                </MudButton>
            </MudStack>
        </MudCardContent>
    </MudCard>
</MudContainer>


@code {
    private string mensajeError = string.Empty;

    private async Task DescargarPdfGeneral()
    {
        try
        {
            mensajeError = string.Empty;
            var response = await Http.GetAsync("api/Reportes/general-pdf");

            if (response.IsSuccessStatusCode)
            {
                var pdfBytes = await response.Content.ReadAsByteArrayAsync();
                var fileName = $"Reporte_General_{DateTime.Now:yyyyMMdd_HHmmss}.pdf";
                var base64 = Convert.ToBase64String(pdfBytes);
                await JS.InvokeVoidAsync("downloadFileFromByteArray", base64, "application/pdf", fileName);
            }
            else
            {
                mensajeError = "No se pudo generar el reporte PDF desde la API. Verificá los permisos o la conexión.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al descargar el PDF: {ex.Message}";
        }
    }
}