@page "/admin/administracion"
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Panel de Administración</PageTitle>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title mb-3">Panel de Administración General</h3>
                    <p class="text-muted">
                        Centro de control exclusivo para administradores. Desde aquí podés auditar la información global del sistema y descargar el informe consolidado exigido por la cátedra.
                    </p>

                    <hr />

                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @mensajeError
                            <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
                        </div>
                    }

                    <div class="d-flex gap-3 align-items-center">
                        <button class="btn btn-danger btn-lg" @onclick="DescargarPdfGeneral">
                            <span class="bi bi-file-earmark-pdf-fill"></span> Descargar Reporte General Consolidado (PDF)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string mensajeError = string.Empty;

    private async Task DescargarPdfGeneral()
    {
        try
        {
            mensajeError = string.Empty;
            var response = await Http.GetAsync("api/Reportes/general-pdf");

            if (response.IsSuccessStatusCode)
            {
                var pdfBytes = await response.Content.ReadAsByteArrayAsync();
                var fileName = $"Reporte_General_{DateTime.Now:yyyyMMdd_HHmmss}.pdf";
                var base64 = Convert.ToBase64String(pdfBytes);
                await JS.InvokeVoidAsync("downloadFileFromByteArray", base64, "application/pdf", fileName);
            }
            else
            {
                mensajeError = "No se pudo generar el reporte PDF desde la API. Verificá los permisos o la conexión.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al descargar el PDF: {ex.Message}";
        }
    }
}