@page "/pos"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Punto de Venta - POS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudGrid>
        <!-- SECCIÓN IZQUIERDA: Catálogo de Productos -->
        <MudItem xs="12" md="8">
            <MudText Typo="Typo.h5" Class="mb-4">Catálogo de Productos</MudText>

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="() => mensajeError = string.Empty" Class="mb-3">
                    @mensajeError
                </MudAlert>
            }

            @if (!string.IsNullOrEmpty(mensajeExito))
            {
                <MudAlert Severity="Severity.Success" ShowCloseIcon="true" CloseIconClicked="() => mensajeExito = string.Empty" Class="mb-3">
                    @mensajeExito
                </MudAlert>
            }

            @if (products == null)
            {
                <MudText Typo="Typo.body1" Style="font-style: italic;">Cargando productos...</MudText>
            }
            else if (!products.Where(p => p.StockActual > 0).Any())
            {
                <MudAlert Severity="Severity.Info">No hay productos disponibles en este momento.</MudAlert>
            }
            else
            {
                <MudGrid>
                    @foreach (var product in products.Where(p => p.StockActual > 0))
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Elevation="3" Class="h-100 d-flex flex-column">
                                <MudCardContent Class="flex-grow-1">
                                    <MudText Typo="Typo.h6">@product.Nombre</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Precio: $@product.PrecioVenta</MudText>
                                    <MudText Typo="Typo.caption">Stock: @product.StockActual</MudText>
                                </MudCardContent>
                                <MudCardActions>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" OnClick="() => AddToCart(product)">
                                        Agregar al Carrito
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudItem>

        <!-- SECCIÓN DERECHA: Carrito de Compras / Ticket -->
        <MudItem xs="12" md="4">
            <MudCard Elevation="3">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-4">Carrito Actual</MudText>

                    @if (!cart.Any())
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">El carrito está vacío.</MudText>
                    }
                    else
                    {
                        <MudList T="CartItem" Class="mb-3">
                            @foreach (var item in cart)
                            {
                                <MudListItem T="CartItem" Class="px-0">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.subtitle2">@item.Product.Nombre</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">Cant: @item.Quantity x $@item.Product.PrecioVenta</MudText>
                                        </MudStack>
                                        <MudStack Row="true" AlignItems="AlignItems.Center">
                                            <MudText Typo="Typo.subtitle2">$@(item.Product.PrecioVenta * item.Quantity)</MudText>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => RemoveFromCart(item)" />
                                        </MudStack>
                                    </MudStack>
                                </MudListItem>
                                <MudDivider />
                            }
                        </MudList>

                        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-4 mt-4">
                            <MudText Typo="Typo.h6"><strong>Total:</strong></MudText>
                            <MudText Typo="Typo.h6"><strong>$@cart.Sum(i => i.Product.PrecioVenta * i.Quantity)</strong></MudText>
                        </MudStack>

                        <!-- PROTECCIÓN CONDICIONAL -->
                        <AuthorizeView>
                            <Authorized>
                                <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Size="Size.Large" OnClick="Checkout">
                                    Completar Venta
                                </MudButton>
                            </Authorized>
                            <NotAuthorized>
                                <MudAlert Severity="Severity.Warning" Class="mb-0 text-center" ContentAlignment="HorizontalAlignment.Center">
                                    <MudText Typo="Typo.body2" Class="mb-2">🔒 Debes iniciar sesión para poder completar la venta.</MudText>
                                    <MudButton Href="login" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth="true">
                                        Ir a Iniciar Sesión
                                    </MudButton>
                                </MudAlert>
                            </NotAuthorized>
                        </AuthorizeView>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private List<ProductModel>? products;
    private List<CartItem> cart = new();
    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
    }

    private async Task CargarProductos()
    {
        try
        {
            products = await Http.GetFromJsonAsync<List<ProductModel>>("api/Productos");
        }
        catch (Exception ex)
        {
            mensajeError = "No se pudieron cargar los productos desde la API.";
        }
    }

    private void AddToCart(ProductModel product)
    {
        mensajeExito = string.Empty;
        mensajeError = string.Empty;

        var existingItem = cart.FirstOrDefault(i => i.Product.Id == product.Id);
        if (existingItem != null)
        {
            if (existingItem.Quantity < product.StockActual)
            {
                existingItem.Quantity++;
            }
            else
            {
                mensajeError = "No hay suficiente stock disponible para agregar más unidades.";
            }
        }
        else
        {
            if (product.StockActual > 0)
            {
                cart.Add(new CartItem { Product = product, Quantity = 1 });
            }
            else
            {
                mensajeError = "El producto se encuentra sin stock.";
            }
        }
    }

    private void RemoveFromCart(CartItem item)
    {
        if (item.Quantity > 1)
        {
            item.Quantity--;
        }
        else
        {
            cart.Remove(item);
        }
    }

    private async Task Checkout()
    {
        mensajeExito = string.Empty;
        mensajeError = string.Empty;

        if (!cart.Any()) return;

        try
        {
            var ventaDto = new
            {
                Fecha = DateTime.Now,
                Detalles = cart.Select(c => new
                {
                    ProductoId = c.Product.Id,
                    Cantidad = c.Quantity
                }).ToList()
            };

            var response = await Http.PostAsJsonAsync("api/Ventas", ventaDto);

            if (response.IsSuccessStatusCode)
            {
                mensajeExito = "¡Venta completada con éxito y stock actualizado!";
                cart.Clear();
                await CargarProductos();
            }
            else
            {
                mensajeError = "Ocurrió un error al procesar la venta en la API.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error de conexión con la API: {ex.Message}";
        }
    }

    public class ProductModel
    {
        public int Id { get; set; }
        public string CodigoBarras { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
        public decimal PrecioVenta { get; set; }
        public int StockActual { get; set; }
    }

    public class CartItem
    {
        public ProductModel Product { get; set; } = new();
        public int Quantity { get; set; }
    }
}