@page "/register"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Registro de Usuario - POS</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-12">
    <MudCard Elevation="4" Class="pa-4">
        <MudCardContent>
            <MudStack AlignItems="AlignItems.Center" Class="mb-6">
                <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h4" Color="Color.Primary">Crear Cuenta</MudText>
            </MudStack>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="() => errorMessage = string.Empty" Class="mb-4">
                    @errorMessage
                </MudAlert>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <MudAlert Severity="Severity.Success" ShowCloseIcon="true" CloseIconClicked="() => successMessage = string.Empty" Class="mb-4">
                    @successMessage
                </MudAlert>
            }

            <EditForm Model="registerModel" OnValidSubmit="HandleRegister">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="registerModel.NombreUsuario"
                              For="@(() => registerModel.NombreUsuario)"
                              Label="Nombre de Usuario"
                              Placeholder="Tu nombre de usuario"
                              Variant="Variant.Outlined"
                              Class="mb-4" />

                <MudTextField @bind-Value="registerModel.Email"
                              For="@(() => registerModel.Email)"
                              Label="Correo Electrónico"
                              Placeholder="correo@ejemplo.com"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              Class="mb-4" />

                <MudTextField @bind-Value="registerModel.Password"
                              For="@(() => registerModel.Password)"
                              Label="Contraseña"
                              Placeholder="••••••••"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Class="mb-6" />

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Success"
                           Size="Size.Large"
                           FullWidth="true"
                           Class="mb-4">
                    Registrarse
                </MudButton>

                <MudText Typo="Typo.body2" Align="Align.Center">
                    ¿Ya tenés una cuenta? <MudLink Href="login" Color="Color.Primary">Iniciá sesión aquí</MudLink>
                </MudText>
            </EditForm>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private RegisterModel registerModel = new();
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private async Task HandleRegister()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync("api/Auth/register", registerModel);

            if (response.IsSuccessStatusCode)
            {
                successMessage = "¡Registro exitoso! Redirigiendo al login...";
                await Task.Delay(2000);
                Navigation.NavigateTo("/login");
            }
            else
            {
                // Captura el mensaje exacto que devuelva el backend (ej: si el email ya está registrado)
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"No se pudo completar el registro: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error de conexión con la API: {ex.Message}";
        }
    }

    public class RegisterModel
    {
        public string NombreUsuario { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}